    "cypress": "^16.2.1",
    "esbuild": "^0.28.2",
    "mochawesome": "^8.1.1",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2",
    "typescript": "^7.0.2"
  }
}
