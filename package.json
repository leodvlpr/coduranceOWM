{
  "name": "ozymandias-weather-tests",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "cy:open": "cypress open --browser chrome",
    "test:api": "cypress run --browser chrome --spec \"cypress/e2e/api/**/*.cy.ts\"",
    "test:ui": "cypress run --browser chrome --spec \"cypress/e2e/ui/**/*.feature\"",
    "test": "cypress run --browser chrome",
    "test:report": "cypress run --browser chrome --reporter mochawesome --reporter-options reportDir=cypress/reports/raw,overwrite=false,html=false,json=true && mochawesome-merge \"cypress/reports/raw/*.json\" -o cypress/reports/mochawesome.json && marge cypress/reports/mochawesome.json --reportDir cypress/reports --reportFilename mochawesome",
    "typecheck": "tsc --noEmit",
    "load": "node scripts/run-load.mjs"
  },
  "keywords": [],
  "author": "Leonel Mujica",
  "license": "MIT",
  "dependencies": {
    "strip-bom": "^2.0.0",
    "strip-bom-stream": "^1.0.0",
    "strip-dirs": "^1.1.1",
    "strip-json-comments": "^2.0.1",
    "sum-up": "^1.0.3",
    "supports-color": "^7.2.0",
    "tar-stream": "^1.6.2",
    "throttleit": "^0.0.2",
    "through2": "^2.0.5",
    "through2-filter": "^2.0.0",
    "timed-out": "^2.0.0",
    "to-absolute-glob": "^0.1.1",
    "to-buffer": "^1.2.2",
    "tough-cookie": "^2.5.0",
    "tunnel-agent": "^0.6.0",
    "tweetnacl": "^0.14.5",
    "typed-array-buffer": "^1.0.3",
    "typedarray": "^0.0.6",
    "undici-types": "^8.9.0",
    "unique-stream": "^2.4.0",
    "update-notifier": "^0.5.0",
    "uri-js": "^4.4.1",
    "util-deprecate": "^1.0.2",
    "uuid": "^8.3.2",
    "vali-date": "^1.0.0",
    "verror": "^1.10.0",
    "vinyl": "^1.2.0",
    "vinyl-assign": "^1.2.1",
    "vinyl-fs": "^2.4.4",
    "which-typed-array": "^1.1.24",
    "wrappy": "^1.0.2",
    "write-file-atomic": "^1.3.4",
    "xdg-basedir": "^2.0.0",
    "xtend": "^4.0.2",
    "xvfb": "^0.3.0",
